@page "/"
@using System.Net
@inject StorageBoxApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Storage Box SSH Key Installer</PageTitle>

<div class="tool-shell">
    <header class="tool-header panel">
        <p class="eyebrow">Hetzner Storage Box</p>
        <h1>SSH Key Installer</h1>
        <p class="intro">
            Create a new SSH key pair or use an existing public key, then install it to
            <code>.ssh/authorized_keys</code> for your Storage Box sub account on port <code>23</code>.
        </p>
    </header>

    <section class="panel">
        <h2>Connection setup</h2>

        <EditForm EditContext="@_editContext" OnSubmit="HandleSubmitAsync" class="form-grid" autocomplete="off">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="field">
                <label for="username">Storage Box username</label>
                <InputText id="username" class="field-input" @bind-Value="Form.Username" autocomplete="username" placeholder="u123456-sub12" />
                <p class="field-hint">Enter the full login, including suffix (for example <code>u123456-sub12</code>).</p>
                <ValidationMessage For="@(() => Form.Username)" />
            </div>

            <div class="field field-full">
                <label for="password">Storage Box password</label>
                <InputText id="password" type="password" class="field-input" @bind-Value="Form.Password" autocomplete="current-password" />
                <ValidationMessage For="@(() => Form.Password)" />
            </div>

            <div class="field field-full">
                <label>Key source</label>
                <InputRadioGroup @bind-Value="Form.KeyMode" class="mode-switch">
                    <label class="mode-option">
                        <InputRadio Value="KeyInputMode.GenerateNewKeyPair" />
                        <span>Generate new SSH key pair</span>
                    </label>
                    <label class="mode-option">
                        <InputRadio Value="KeyInputMode.UseExistingPublicKey" />
                        <span>Use existing public key</span>
                    </label>
                </InputRadioGroup>
            </div>

            @if (Form.KeyMode == KeyInputMode.GenerateNewKeyPair)
            {
                <div class="field">
                    <label for="algorithm">Algorithm</label>
                    <InputSelect id="algorithm" class="field-input" @bind-Value="SelectedAlgorithm">
                        <option value="ed25519">ed25519</option>
                        <option value="ecdsa">ecdsa</option>
                        <option value="rsa">rsa</option>
                    </InputSelect>
                </div>

                @if (Form.Algorithm is "ecdsa" or "rsa")
                {
                    <div class="field">
                        <label for="keySize">Key size</label>
                        <InputSelect id="keySize" class="field-input" @bind-Value="Form.KeySize">
                            @if (Form.Algorithm == "ecdsa")
                            {
                                <option value="256">256</option>
                                <option value="384">384</option>
                                <option value="521">521</option>
                            }
                            else
                            {
                                <option value="2048">2048</option>
                                <option value="3072">3072</option>
                                <option value="4096">4096</option>
                                <option value="8192">8192</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Form.KeySize)" />
                    </div>
                }

                <div class="field">
                    <label for="keyPassphrase">Key passphrase (optional)</label>
                    <InputText id="keyPassphrase" type="password" class="field-input" @bind-Value="Form.KeyPassphrase" autocomplete="new-password" />
                    <ValidationMessage For="@(() => Form.KeyPassphrase)" />
                </div>

                <div class="field">
                    <label for="confirmKeyPassphrase">Confirm passphrase</label>
                    <InputText id="confirmKeyPassphrase" type="password" class="field-input" @bind-Value="Form.ConfirmKeyPassphrase" autocomplete="new-password" />
                    <ValidationMessage For="@(() => Form.ConfirmKeyPassphrase)" />
                </div>

                <div class="field field-full">
                    <label for="keyComment">Key comment (optional)</label>
                    <InputText id="keyComment" class="field-input" @bind-Value="Form.KeyComment" placeholder="Defaults to login@host" />
                    <ValidationMessage For="@(() => Form.KeyComment)" />
                </div>
            }
            else
            {
                <div class="field field-full">
                    <label for="providedKey">Public key (OpenSSH, one line)</label>
                    <InputTextArea id="providedKey" class="field-input key-input" @bind-Value="Form.ProvidedPublicKey" placeholder="ssh-ed25519 AAAAC3... user@host" />
                    <ValidationMessage For="@(() => Form.ProvidedPublicKey)" />
                </div>

                <div class="field field-full">
                    <label for="publicKeyUpload">Or load from file</label>
                    <InputFile id="publicKeyUpload" OnChange="HandlePublicKeyUploadAsync" accept=".pub,text/plain" />
                    @if (!string.IsNullOrWhiteSpace(UploadedPublicKeyFileName))
                    {
                        <p class="field-hint">Loaded file: <code>@UploadedPublicKeyFileName</code></p>
                    }
                </div>
            }

            <div class="derived box">
                <h3>Derived Storage Box values</h3>
                <dl>
                    <div>
                        <dt>Login</dt>
                        <dd><code>@DerivedLogin</code></dd>
                    </div>
                    <div>
                        <dt>Host</dt>
                        <dd><code>@DerivedHost</code></dd>
                    </div>
                    <div>
                        <dt>Port</dt>
                        <dd><code>23</code></dd>
                    </div>
                </dl>
            </div>

            <div class="actions field-full">
                <button type="submit" class="btn btn-primary" disabled="@IsBusy">
                    @(IsBusy ? "Running..." : "Start process")
                </button>
                <button type="button" class="btn btn-secondary" @onclick="ResetAll" disabled="@IsBusy">Reset / Start over</button>

                @if (AwaitingOverwrite)
                {
                    <button type="button" class="btn btn-danger" @onclick="ConfirmOverwriteAsync" disabled="@IsBusy">
                        Overwrite remote authorized_keys
                    </button>
                }
            </div>
        </EditForm>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="panel status error">
            <h2>Error</h2>
            <p>@ErrorMessage</p>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <section class="panel status success">
            <h2>Success</h2>
            <p>@SuccessMessage</p>
        </section>
    }

    @if (LastCheck is { State: RemoteKeyState.Different })
    {
        <section class="panel status warning">
            <h2>Overwrite required</h2>
            <p>The destination file <code>@LastCheck.DestinationPath</code> already exists and differs from your provided key.</p>
            <p>Existing fingerprint: <code>@(LastCheck.ExistingFingerprintSha256 ?? "not available")</code></p>
            <p>New fingerprint: <code>@LastCheck.IncomingFingerprintSha256</code></p>
        </section>
    }

    @if (GeneratedKey is not null)
    {
        <section class="panel">
            <h2>Generated key pair</h2>
            <p class="warning-note">The private key is shown only in this browser session. Download and store it securely now.</p>
            <div class="key-grid">
                <div>
                    <label>Private key</label>
                    <textarea readonly class="key-output">@GeneratedKey.PrivateKey</textarea>
                    <button type="button" class="btn btn-secondary" @onclick="DownloadPrivateKeyAsync">Download private key</button>
                </div>
                <div>
                    <label>Public key</label>
                    <textarea readonly class="key-output">@GeneratedKey.PublicKey</textarea>
                    <button type="button" class="btn btn-secondary" @onclick="DownloadPublicKeyAsync">Download public key</button>
                </div>
            </div>
            <p class="field-hint">Fingerprint: <code>@GeneratedKey.FingerprintSha256</code></p>
        </section>
    }

    <section class="panel">
        <h2>Process log</h2>
        @if (Logs.Count == 0)
        {
            <p class="field-hint">No operations yet.</p>
        }
        else
        {
            <ol class="log-list">
                @foreach (var log in Logs)
                {
                    <li class="@($"log-entry {log.CssClass}")">
                        <div class="log-meta">
                            <span>@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                            <strong>@log.Step</strong>
                        </div>
                        <p>@log.Message</p>
                    </li>
                }
            </ol>
        }
    </section>
</div>

@code {
    private StorageBoxFormModel Form { get; set; } = new();

    private EditContext _editContext = default!;

    private List<ProcessLogEntry> Logs { get; } = [];

    private bool IsBusy { get; set; }

    private bool AwaitingOverwrite { get; set; }

    private string? ErrorMessage { get; set; }

    private string? SuccessMessage { get; set; }

    private string? UploadedPublicKeyFileName { get; set; }

    private string? PreparedPublicKey { get; set; }

    private GenerateKeyResponse? GeneratedKey { get; set; }

    private CheckKeyResponse? LastCheck { get; set; }

    private string SelectedAlgorithm
    {
        get => Form.Algorithm;
        set
        {
            Form.Algorithm = value;
            ApplyAlgorithmDefaults();
        }
    }

    private string DerivedLogin
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Form.Username))
            {
                return "<username>-sub<sub-id>";
            }

            return Form.Username.Trim().ToLowerInvariant();
        }
    }

    private string DerivedHost
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Form.Username))
            {
                return "<username>-sub<sub-id>.your-storagebox.de";
            }

            return $"{Form.Username.Trim().ToLowerInvariant()}.your-storagebox.de";
        }
    }

    protected override void OnInitialized()
    {
        ApplyAlgorithmDefaults();
        _editContext = new EditContext(Form);
    }

    private async Task HandleSubmitAsync(EditContext _)
    {
        if (IsBusy)
        {
            return;
        }

        if (!_editContext.Validate())
        {
            AddLog("Validate", "Please fix the highlighted form errors before starting.", ProcessLogLevel.Warning);
            return;
        }

        await RunWorkflowAsync();
    }

    private async Task RunWorkflowAsync()
    {
        IsBusy = true;
        AwaitingOverwrite = false;
        ErrorMessage = null;
        SuccessMessage = null;
        PreparedPublicKey = null;
        LastCheck = null;
        GeneratedKey = null;
        Logs.Clear();

        try
        {
            AddLog("Validate", "Input accepted. Preparing workflow.", ProcessLogLevel.Info);

            var publicKey = await ResolvePublicKeyAsync();
            PreparedPublicKey = publicKey;

            AddLog("Check", "Connecting to Storage Box and checking remote authorized_keys.", ProcessLogLevel.Info);
            var checkResponse = await ApiClient.CheckRemoteKeyAsync(
                new CheckKeyRequest(
                    Form.Username.Trim().ToLowerInvariant(),
                    Form.Password,
                    publicKey
                ),
                CancellationToken.None
            );

            LastCheck = checkResponse;

            if (checkResponse.State == RemoteKeyState.Identical)
            {
                SuccessMessage = "Remote authorized_keys already matches your key. Nothing to overwrite.";
                AddLog("Done", SuccessMessage, ProcessLogLevel.Success);
                ClearSensitiveFields();
                return;
            }

            if (checkResponse.State == RemoteKeyState.Different)
            {
                AwaitingOverwrite = true;
                AddLog("Conflict", "Remote authorized_keys differs. Confirm overwrite to continue.", ProcessLogLevel.Warning);
                return;
            }

            await UploadAsync(overwrite: false);
        }
        catch (ApiClientException ex)
        {
            HandleApiError(ex);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            AddLog("Error", ex.Message, ProcessLogLevel.Error);
        }
        finally
        {
            if (!AwaitingOverwrite)
            {
                ClearSensitiveFields();
            }

            IsBusy = false;
        }
    }

    private async Task ConfirmOverwriteAsync()
    {
        if (IsBusy || string.IsNullOrWhiteSpace(PreparedPublicKey))
        {
            return;
        }

        IsBusy = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            AddLog("Upload", "Overwrite confirmed by user. Uploading remote authorized_keys.", ProcessLogLevel.Warning);
            await UploadAsync(overwrite: true);
        }
        catch (ApiClientException ex)
        {
            HandleApiError(ex);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            AddLog("Error", ex.Message, ProcessLogLevel.Error);
        }
        finally
        {
            if (!AwaitingOverwrite)
            {
                ClearSensitiveFields();
            }

            IsBusy = false;
        }
    }

    private async Task UploadAsync(bool overwrite)
    {
        if (string.IsNullOrWhiteSpace(PreparedPublicKey))
        {
            throw new InvalidOperationException("No public key is available for upload.");
        }

        AddLog("Upload", "Uploading key to remote .ssh/authorized_keys.", ProcessLogLevel.Info);
        var uploadResponse = await ApiClient.UploadRemoteKeyAsync(
            new UploadKeyRequest(
                Form.Username.Trim().ToLowerInvariant(),
                Form.Password,
                PreparedPublicKey,
                overwrite
            ),
            CancellationToken.None
        );

        AwaitingOverwrite = false;
        LastCheck = null;
        SuccessMessage = uploadResponse.Message;

        if (uploadResponse.Changed)
        {
            AddLog("Done", $"Success. {uploadResponse.Message}", ProcessLogLevel.Success);
        }
        else
        {
            AddLog("Done", "No remote change was needed.", ProcessLogLevel.Success);
        }

        ClearSensitiveFields();
    }

    private async Task<string> ResolvePublicKeyAsync()
    {
        if (Form.KeyMode == KeyInputMode.UseExistingPublicKey)
        {
            AddLog("Key", "Using provided public key.", ProcessLogLevel.Info);
            return Form.ProvidedPublicKey?.Trim() ?? string.Empty;
        }

        AddLog("Key generation", "Creating a new SSH key pair.", ProcessLogLevel.Info);
        var generated = await ApiClient.GenerateKeyAsync(
            new GenerateKeyRequest(
                Form.Username.Trim().ToLowerInvariant(),
                Form.Algorithm,
                Form.KeySize,
                Form.KeyPassphrase,
                string.IsNullOrWhiteSpace(Form.KeyComment) ? null : Form.KeyComment.Trim()
            ),
            CancellationToken.None
        );

        GeneratedKey = generated;
        AddLog("Key generation", $"Generated {generated.Algorithm} key ({generated.FingerprintSha256}).", ProcessLogLevel.Success);
        return generated.PublicKey;
    }

    private void HandleApiError(ApiClientException exception)
    {
        if (exception.StatusCode == HttpStatusCode.Conflict)
        {
            AwaitingOverwrite = true;
        }

        var detailSuffix = string.IsNullOrWhiteSpace(exception.Detail)
            ? string.Empty
            : $" Detail: {exception.Detail}";

        ErrorMessage = $"{exception.Step}: {exception.Message}";
        AddLog("Error", $"{ErrorMessage}{detailSuffix}", ProcessLogLevel.Error);
    }

    private void ClearSensitiveFields()
    {
        Form.Password = string.Empty;
        Form.KeyPassphrase = string.Empty;
        Form.ConfirmKeyPassphrase = string.Empty;
    }

    private async Task HandlePublicKeyUploadAsync(InputFileChangeEventArgs eventArgs)
    {
        if (eventArgs.FileCount == 0)
        {
            return;
        }

        var file = eventArgs.File;

        try
        {
            const long maxBytes = 64 * 1024;
            await using var stream = file.OpenReadStream(maxAllowedSize: maxBytes);
            using var reader = new StreamReader(stream);

            Form.ProvidedPublicKey = await reader.ReadToEndAsync();
            UploadedPublicKeyFileName = file.Name;
            AddLog("Input", $"Loaded public key from file '{file.Name}'.", ProcessLogLevel.Info);

            _editContext.NotifyFieldChanged(new FieldIdentifier(Form, nameof(Form.ProvidedPublicKey)));
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Could not read uploaded key file: {ex.Message}";
            AddLog("Error", ErrorMessage, ProcessLogLevel.Error);
        }
    }

    private void ApplyAlgorithmDefaults()
    {
        var algorithm = (Form.Algorithm ?? "ed25519").Trim().ToLowerInvariant();
        Form.Algorithm = algorithm;

        switch (algorithm)
        {
            case "ed25519":
                Form.KeySize = null;
                break;
            case "ecdsa" when Form.KeySize is not (256 or 384 or 521):
                Form.KeySize = 384;
                break;
            case "rsa" when Form.KeySize is null or < 2048 or > 8192:
                Form.KeySize = 3072;
                break;
        }
    }

    private async Task DownloadPrivateKeyAsync()
    {
        if (GeneratedKey is null)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync(
            "storageBoxKeyTool.downloadTextFile",
            BuildFilePrefix() + "_private.key",
            GeneratedKey.PrivateKey
        );
    }

    private async Task DownloadPublicKeyAsync()
    {
        if (GeneratedKey is null)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync(
            "storageBoxKeyTool.downloadTextFile",
            BuildFilePrefix() + ".pub",
            GeneratedKey.PublicKey + "\n"
        );
    }

    private string BuildFilePrefix()
    {
        var login = string.IsNullOrWhiteSpace(Form.Username)
            ? "storagebox"
            : Form.Username.Trim().ToLowerInvariant();

        var algorithm = GeneratedKey?.Algorithm?.Replace('-', '_') ?? "ssh_key";

        return $"{SanitizeForFileName(login)}_{SanitizeForFileName(algorithm)}";
    }

    private static string SanitizeForFileName(string input)
    {
        var invalidChars = Path.GetInvalidFileNameChars();
        var sanitized = new string(input.Select(ch => invalidChars.Contains(ch) ? '_' : ch).ToArray());
        return string.IsNullOrWhiteSpace(sanitized) ? "key" : sanitized;
    }

    private void ResetAll()
    {
        IsBusy = false;
        AwaitingOverwrite = false;
        ErrorMessage = null;
        SuccessMessage = null;
        UploadedPublicKeyFileName = null;
        PreparedPublicKey = null;
        GeneratedKey = null;
        LastCheck = null;
        Logs.Clear();

        Form = new StorageBoxFormModel();
        ApplyAlgorithmDefaults();
        _editContext = new EditContext(Form);
    }

    private void AddLog(string step, string message, ProcessLogLevel level)
    {
        Logs.Add(new ProcessLogEntry(DateTimeOffset.UtcNow, step, message, level));
    }

    private sealed record ProcessLogEntry(DateTimeOffset Timestamp, string Step, string Message, ProcessLogLevel Level)
    {
        public string CssClass => Level switch
        {
            ProcessLogLevel.Success => "success",
            ProcessLogLevel.Warning => "warning",
            ProcessLogLevel.Error => "error",
            _ => "info"
        };
    }

    private enum ProcessLogLevel
    {
        Info,
        Success,
        Warning,
        Error
    }
}
