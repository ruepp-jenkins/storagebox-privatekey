@page "/backrest-restic"
@using System.Text.RegularExpressions
@inject StorageBoxApiClient ApiClient
@inject StorageBoxConnectionState ConnectionState
@implements IDisposable

<PageTitle>Hetzner StorageBox Helper - backrest / restic</PageTitle>

<div class="tool-shell">
    <header class="tool-header panel">
        <p class="eyebrow">Hetzner StorageBox Helper</p>
        <h1>backrest / restic</h1>
        <p class="intro">
            Configure command-based SSH login for restic via rclone and ensure
            <code>@RcloneConfigPathPreview</code> exists.
        </p>
    </header>

    <section class="panel">
        <h2>Compatibility setup</h2>
        <p class="field-hint">Global username and password are configured in the left navigation.</p>

        <EditForm EditContext="@_editContext" OnSubmit="HandleSubmitAsync" class="form-grid" autocomplete="off">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="field field-full box">
                <label for="rootDirectory">Root directory</label>
                <InputText id="rootDirectory" class="field-input" @bind-Value="Form.RootDirectory" placeholder="/home" />
                <p class="field-hint">Must be <code>/home</code> or start with <code>/home/</code>.</p>
                <ValidationMessage For="@(() => Form.RootDirectory)" />
            </div>

            <div class="field-full box connection-guide">
                <h3>Connection values for backrest / restic</h3>
                <p class="field-hint">After compatibility is applied, use these values in your backrest/restic repository configuration.</p>

                <div class="field">
                    <label for="privateKeyPath">Local private key path</label>
                    <InputText id="privateKeyPath" class="field-input" @bind-Value="PrivateKeyPath" @bind-Value:event="oninput" placeholder="~/.ssh/id_ed25519" />
                    <p class="field-hint">If your key is stored elsewhere, update this path.</p>
                </div>

                <ul>
                    <li>Repository URI: <code>rclone:</code></li>
                    <li>Flags: <code>@ResticFlags</code></li>
                </ul>

                <p class="field-hint">
                    <code>rclone:</code> is correct. Connection details are supplied via the flags.
                    Root in use: <code>@EffectiveRootDirectory</code>.
                </p>
            </div>

            <div class="actions field-full">
                <button type="submit" class="btn btn-primary" disabled="@IsBusy">
                    @(IsBusy ? "Running..." : "Apply compatibility")
                </button>
                <button type="button" class="btn btn-secondary" @onclick="ResetAll" disabled="@IsBusy">Reset / Start over</button>
            </div>
        </EditForm>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="panel status error">
            <h2>Error</h2>
            <p>@ErrorMessage</p>
            @if (NeedsSftpSetup)
            {
                <p>
                    Continue in the
                    <NavLink class="inline-link" href="/sftp-key">sFTP key</NavLink>
                    tab first.
                </p>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <section class="panel status success">
            <h2>Success</h2>
            <p>@SuccessMessage</p>
        </section>
    }

    <section class="panel">
        <h2>Process log</h2>
        @if (Logs.Count == 0)
        {
            <p class="field-hint">No operations yet.</p>
        }
        else
        {
            <ol class="log-list">
                @foreach (var log in Logs)
                {
                    <li class="@($"log-entry {log.CssClass}")">
                        <div class="log-meta">
                            <span>@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                            <strong>@log.Step</strong>
                        </div>
                        <p>@log.Message</p>
                    </li>
                }
            </ol>
        }
    </section>
</div>

@code {
    private BackrestResticFormModel Form { get; set; } = new();

    private EditContext _editContext = default!;

    private List<ProcessLogEntry> Logs { get; } = [];

    private bool IsBusy { get; set; }

    private bool NeedsSftpSetup { get; set; }

    private string? ErrorMessage { get; set; }

    private string? SuccessMessage { get; set; }

    private string PrivateKeyPath { get; set; } = "~/.ssh/id_ed25519";

    private string DerivedLogin
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ConnectionState.Username))
            {
                return "<username>-sub<sub-id>";
            }

            return ConnectionState.Username.Trim().ToLowerInvariant();
        }
    }

    private string DerivedHost
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ConnectionState.Username))
            {
                return "<username>-sub<sub-id>.your-storagebox.de";
            }

            return $"{ConnectionState.Username.Trim().ToLowerInvariant()}.your-storagebox.de";
        }
    }

    private string EffectiveRootDirectory => ResolveRootDirectory();

    private string RcloneConfigPathPreview => $"{EffectiveRootDirectory}/.config/rclone/rclone.conf";

    private string ResticFlags => $"-o rclone.program=\"ssh -p 23 {DerivedLogin}@{DerivedHost} -i {EffectivePrivateKeyPath}\"";

    private string EffectivePrivateKeyPath => string.IsNullOrWhiteSpace(PrivateKeyPath)
        ? "~/.ssh/id_ed25519"
        : PrivateKeyPath.Trim();

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Form);
        ConnectionState.Changed += HandleConnectionChanged;
    }

    private async Task HandleSubmitAsync(EditContext _)
    {
        if (IsBusy)
        {
            return;
        }

        if (!_editContext.Validate())
        {
            AddLog("Validate", "Please fix the highlighted form errors before starting.", ProcessLogLevel.Warning);
            return;
        }

        if (!TryGetConnection(out var username, out var password))
        {
            return;
        }

        await RunWorkflowAsync(username, password);
    }

    private async Task RunWorkflowAsync(string username, string password)
    {
        IsBusy = true;
        ErrorMessage = null;
        SuccessMessage = null;
        NeedsSftpSetup = false;
        Logs.Clear();

        try
        {
            AddLog("Validate", "Input accepted. Preparing workflow.", ProcessLogLevel.Info);
            AddLog("Pre-check", "Checking whether SSH key login already exists.", ProcessLogLevel.Info);

            var precheckResponse = await ApiClient.CheckSshLoginAsync(
                new CheckSshLoginRequest(
                    username,
                    password,
                    EffectiveRootDirectory
                ),
                CancellationToken.None
            );

            if (!precheckResponse.HasSshPublicKey)
            {
                NeedsSftpSetup = true;
                ErrorMessage = $"No SSH key login is configured at '{precheckResponse.DestinationPath}'.";
                AddLog("Pre-check", "Missing SSH key login. Configure it first in the sFTP key tab.", ProcessLogLevel.Error);
                return;
            }

            AddLog("Apply", "Applying backrest/restic compatibility setup.", ProcessLogLevel.Info);

            var applyResponse = await ApiClient.ApplyBackrestResticAsync(
                new ApplyBackrestResticRequest(
                    username,
                    password,
                    EffectiveRootDirectory
                ),
                CancellationToken.None
            );

            SuccessMessage = applyResponse.Message;

            if (applyResponse.Changed)
            {
                AddLog("Done", $"Success. {applyResponse.Message}", ProcessLogLevel.Success);
            }
            else
            {
                AddLog("Done", "Backrest/restic setup already matched the desired state.", ProcessLogLevel.Success);
            }
        }
        catch (ApiClientException ex)
        {
            HandleApiError(ex);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            AddLog("Error", ex.Message, ProcessLogLevel.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void HandleApiError(ApiClientException exception)
    {
        var detailSuffix = string.IsNullOrWhiteSpace(exception.Detail)
            ? string.Empty
            : $" Detail: {exception.Detail}";

        ErrorMessage = $"{exception.Step}: {exception.Message}";
        NeedsSftpSetup = exception.Message.Contains("sFTP key tab", StringComparison.OrdinalIgnoreCase)
            || exception.Message.Contains("No SSH key login is configured", StringComparison.OrdinalIgnoreCase);
        AddLog("Error", $"{ErrorMessage}{detailSuffix}", ProcessLogLevel.Error);
    }

    private string ResolveRootDirectory()
    {
        if (string.IsNullOrWhiteSpace(Form.RootDirectory))
        {
            return "/home";
        }

        var normalizedRootDirectory = Form.RootDirectory.Trim();
        if (normalizedRootDirectory.Length > 1)
        {
            normalizedRootDirectory = normalizedRootDirectory.TrimEnd('/');
        }

        return string.IsNullOrWhiteSpace(normalizedRootDirectory)
            ? "/home"
            : normalizedRootDirectory;
    }

    private bool TryGetConnection(out string username, out string password)
    {
        username = ConnectionState.Username.Trim().ToLowerInvariant();
        password = ConnectionState.Password;

        if (string.IsNullOrWhiteSpace(username))
        {
            ErrorMessage = "Set the global Storage Box username in the left navigation first.";
            AddLog("Validate", ErrorMessage, ProcessLogLevel.Warning);
            return false;
        }

        if (!UsernamePattern.IsMatch(username))
        {
            ErrorMessage = "Global username must use format <base>-sub<id> (for example u123456-sub12).";
            AddLog("Validate", ErrorMessage, ProcessLogLevel.Warning);
            return false;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            ErrorMessage = "Set the global Storage Box password in the left navigation first.";
            AddLog("Validate", ErrorMessage, ProcessLogLevel.Warning);
            return false;
        }

        return true;
    }

    private void HandleConnectionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ConnectionState.Changed -= HandleConnectionChanged;
    }

    private void ResetAll()
    {
        IsBusy = false;
        NeedsSftpSetup = false;
        ErrorMessage = null;
        SuccessMessage = null;
        PrivateKeyPath = "~/.ssh/id_ed25519";
        Logs.Clear();

        Form = new BackrestResticFormModel();
        _editContext = new EditContext(Form);
    }

    private void AddLog(string step, string message, ProcessLogLevel level)
    {
        Logs.Add(new ProcessLogEntry(DateTimeOffset.UtcNow, step, message, level));
    }

    private sealed record ProcessLogEntry(DateTimeOffset Timestamp, string Step, string Message, ProcessLogLevel Level)
    {
        public string CssClass => Level switch
        {
            ProcessLogLevel.Success => "success",
            ProcessLogLevel.Warning => "warning",
            ProcessLogLevel.Error => "error",
            _ => "info"
        };
    }

    private enum ProcessLogLevel
    {
        Info,
        Success,
        Warning,
        Error
    }

    private static readonly Regex UsernamePattern = new("^[a-z0-9]{1,32}-sub[0-9]{1,6}$", RegexOptions.CultureInvariant);
}
