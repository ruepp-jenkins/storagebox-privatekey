@inherits LayoutComponentBase
@using System.Net
@using System.Net.Sockets
@inject StorageBoxConnectionState ConnectionState
@inject StorageBoxApiClient ApiClient
@inject NavigationManager Navigation

@if (_showNonLocalHostWarning)
{
    <section class="public-warning" role="alert" aria-live="polite">
        <strong>Security warning: this instance is not running on a local/private host.</strong>
        <p>
            Current host: <code>@_currentHost</code>. Anyone with access to this UI can submit Storage Box credentials.
            Run locally whenever possible, or set <code>STORAGEBOX_DISABLE_NON_LOCAL_WARNING=true</code> only when this is intentionally hosted.
        </p>
    </section>
}

<div class="layout-shell">
    <aside class="layout-nav" aria-label="Primary navigation">
        <div class="brand">
            <p class="eyebrow">Hetzner</p>
            <h1>StorageBox Helper</h1>
            <p class="tagline">SSH/SFTP workflows on port <code>23</code></p>
        </div>

        <nav class="nav-list">
            <NavLink href="/sftp-key" class="nav-link" Match="NavLinkMatch.All">
                <span class="nav-title">sFTP key</span>
                <span class="nav-copy">Generate or upload key login</span>
            </NavLink>

            <NavLink href="/backrest-restic" class="nav-link" Match="NavLinkMatch.All">
                <span class="nav-title">backrest / restic</span>
                <span class="nav-copy">Prepare rclone/restic compatibility</span>
            </NavLink>
        </nav>

        <section class="connection-box">
            <h2>Global connection</h2>
            <p class="connection-copy">Used by both navigation entries.</p>

            <EditableInputBox
                Id="globalUsername"
                Label="Storage Box username"
                Value="@ConnectionState.Username"
                ValueChanged="HandleUsernameChanged"
                Placeholder="u123456-sub12"
                Autocomplete="username" />

            <EditableInputBox
                Id="globalPassword"
                Label="Storage Box password"
                Value="@ConnectionState.Password"
                ValueChanged="HandlePasswordChanged"
                Type="password"
                Autocomplete="current-password" />

            <div class="connection-host">
                <ReadOnlyCopyBox Label="Hostname in use" Value="@DerivedHost" EmptyDisplay="add username" CanCopy="@CanCopyHost" />
            </div>
        </section>

        <footer class="nav-footer">
            <span class="copyright">&copy; Stefan Ruepp</span>
            <a href="https://github.com/ruepp-jenkins/storagebox-privatekey" target="_blank" rel="noopener noreferrer" class="github-link" aria-label="GitHub repository">
                <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
            </a>
        </footer>
    </aside>

    <section class="layout-page">
        @Body
    </section>
</div>

@code {
    private bool _showNonLocalHostWarning;
    private string _currentHost = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _currentHost = ResolveCurrentHost();
        if (IsLocalOrPrivateHost(_currentHost))
        {
            return;
        }

        try
        {
            var response = await ApiClient.GetUiSecurityConfigAsync(CancellationToken.None);
            _showNonLocalHostWarning = !response.SuppressNonLocalHostWarning;
        }
        catch
        {
            _showNonLocalHostWarning = true;
        }
    }

    private string ResolveCurrentHost()
    {
        if (!Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri))
        {
            return "unknown";
        }

        return string.IsNullOrWhiteSpace(uri.Host)
            ? "unknown"
            : uri.Host;
    }

    private static bool IsLocalOrPrivateHost(string host)
    {
        if (string.IsNullOrWhiteSpace(host) || string.Equals(host, "unknown", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var normalizedHost = host.Trim().Trim('[', ']').TrimEnd('.');
        if (string.Equals(normalizedHost, "localhost", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (!IPAddress.TryParse(normalizedHost, out var ipAddress))
        {
            return false;
        }

        if (IPAddress.IsLoopback(ipAddress))
        {
            return true;
        }

        if (ipAddress.AddressFamily == AddressFamily.InterNetwork)
        {
            var octets = ipAddress.GetAddressBytes();
            return octets[0] == 10
                || (octets[0] == 172 && octets[1] >= 16 && octets[1] <= 31)
                || (octets[0] == 192 && octets[1] == 168)
                || (octets[0] == 169 && octets[1] == 254);
        }

        if (ipAddress.AddressFamily == AddressFamily.InterNetworkV6)
        {
            if (ipAddress.IsIPv6LinkLocal || ipAddress.IsIPv6SiteLocal)
            {
                return true;
            }

            var octets = ipAddress.GetAddressBytes();
            return (octets[0] & 0xFE) == 0xFC;
        }

        return false;
    }

    private Task HandleUsernameChanged(string value)
    {
        ConnectionState.Username = value;
        return Task.CompletedTask;
    }

    private Task HandlePasswordChanged(string value)
    {
        ConnectionState.Password = value;
        return Task.CompletedTask;
    }

    private string DerivedHost
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ConnectionState.Username))
            {
                return string.Empty;
            }

            return $"{ConnectionState.Username.Trim().ToLowerInvariant()}.your-storagebox.de";
        }
    }

    private bool CanCopyHost => !string.IsNullOrWhiteSpace(DerivedHost);
}
