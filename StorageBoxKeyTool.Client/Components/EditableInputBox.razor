@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms

<div class="value-box editable-box">
    <div class="value-box-header">
        <label for="@Id">@Label</label>
    </div>

    @if (Multiline)
    {
        <textarea
            id="@Id"
            class="value-input value-textarea"
            rows="@Rows"
            @oninput="HandleInput"
            autocomplete="@Autocomplete"
            placeholder="@Placeholder">@Value</textarea>
    }
    else
    {
        <input
            id="@Id"
            type="@Type"
            class="value-input"
            value="@Value"
            @oninput="HandleInput"
            autocomplete="@Autocomplete"
            placeholder="@Placeholder" />
    }

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <p class="value-hint">@Hint</p>
    }
</div>

@code {
    [CascadingParameter]
    private EditContext? CascadedEditContext { get; set; }

    [Parameter]
    public required string Id { get; set; }

    [Parameter]
    public required string Label { get; set; }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public bool Multiline { get; set; }

    [Parameter]
    public int Rows { get; set; } = 5;

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Autocomplete { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    private FieldIdentifier _fieldIdentifier;

    private bool _hasFieldIdentifier;

    protected override void OnParametersSet()
    {
        if (ValueExpression is null)
        {
            _hasFieldIdentifier = false;
            return;
        }

        _fieldIdentifier = FieldIdentifier.Create(ValueExpression);
        _hasFieldIdentifier = true;
    }

    private async Task HandleInput(ChangeEventArgs eventArgs)
    {
        await ValueChanged.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty);

        if (_hasFieldIdentifier && CascadedEditContext is not null)
        {
            CascadedEditContext.NotifyFieldChanged(_fieldIdentifier);
        }
    }
}
