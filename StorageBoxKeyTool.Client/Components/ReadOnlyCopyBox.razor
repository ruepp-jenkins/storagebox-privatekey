@inject IJSRuntime JsRuntime

<div class="value-box readonly-box">
    <div class="value-box-header">
        <label class="value-label" for="@_valueElementId">@Label</label>
    </div>

    <div class="value-row">
        @if (UseMultiline)
        {
            <textarea
                id="@_valueElementId"
                class="value-display value-textarea @(Monospace ? "mono" : string.Empty)"
                readonly
                rows="@Rows"
                title="@DisplayValue"
                @onclick="SelectAllAsync"
                @onfocus="SelectAllAsync">@DisplayValue</textarea>
        }
        else
        {
            <input
                id="@_valueElementId"
                class="value-display @(Monospace ? "mono" : string.Empty)"
                type="text"
                readonly
                value="@DisplayValue"
                title="@DisplayValue"
                @onclick="SelectAllAsync"
                @onfocus="SelectAllAsync" />
        }

        <button type="button" class="copy-btn" @onclick="CopyAsync" disabled="@(!CanCopyValue)">Copy</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <p class="value-hint">@Hint</p>
    }

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <p class="value-feedback">@_feedback</p>
    }
</div>

@code {
    private string? _feedback;

    private readonly string _valueElementId = $"readonly_{Guid.NewGuid():N}";

    [Parameter]
    public required string Label { get; set; }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public bool CanCopy { get; set; } = true;

    [Parameter]
    public string EmptyDisplay { get; set; } = "not available";

    [Parameter]
    public bool Monospace { get; set; } = true;

    [Parameter]
    public bool Multiline { get; set; }

    [Parameter]
    public int Rows { get; set; } = 5;

    [Parameter]
    public string? Hint { get; set; }

    private string DisplayValue => string.IsNullOrWhiteSpace(Value)
        ? EmptyDisplay
        : Value;

    private bool UseMultiline => Multiline || DisplayValue.Contains('\n', StringComparison.Ordinal);

    private bool CanCopyValue => CanCopy && !string.IsNullOrWhiteSpace(Value);

    private async Task SelectAllAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("storageBoxKeyTool.selectText", _valueElementId);
        }
        catch (JSException)
        {
        }
    }

    private async Task CopyAsync()
    {
        if (!CanCopyValue)
        {
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("storageBoxKeyTool.copyText", Value);
            _feedback = "Copied.";
        }
        catch (JSException)
        {
            _feedback = "Copy failed in this browser context. Please copy manually.";
        }
    }
}
